# WAHA Plus instance (run it with WHATSAPP_DEFAULT_ENGINE=NOWEB).
WAHA_BASE_URL=https://waha.example.com
WAHA_API_KEY=replace-with-your-waha-api-key
WAHA_SESSION=default
# Local number (08...), international number (628...), or a full chat ID
# such as 628123456789@c.us or 1203630xxxxx@g.us for a group.
WAHA_TARGET=08123456789
WAHA_COUNTRY_CODE=62
# Optional. Placeholders: {distanceCm}, {thresholdCm}, {time}. Falls back to
# "Peringatan : Tempat Sampah Hampir Penuh" when unset.
ALERT_MESSAGE=Peringatan : Tempat Sampah Hampir Penuh
DEVICE_API_KEY=replace-with-a-long-random-device-key
